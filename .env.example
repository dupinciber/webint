# =============================================================================
# DUPIN WEBINT — example configuration. Copy to .env and fill in your own values.
# NEVER commit the real .env file.
# =============================================================================

# --- AI (BYOK) ---------------------------------------------------------------
# Works with ANY OpenAI-compatible chat API: OpenAI, DeepSeek, Groq, Mistral,
# xAI, OpenRouter, Ollama, vLLM, LM Studio... The defaults below point to
# DeepSeek; change the base URL + model names to use your provider of choice.
# If the key is missing, the CLI asks for it on first run and saves it in
# ~/.config/dupinciber/webint.env (0600, OUTSIDE this repository).
DUPIN_AI_API_KEY=your-ai-key
# DUPIN_AI_BASE_URL=https://api.deepseek.com
# DUPIN_AI_MODEL_FLASH=deepseek-v4-flash
# DUPIN_AI_MODEL_PRO=deepseek-v4-pro
#
# OpenRouter example (one key, any model — including Anthropic/Gemini):
# DUPIN_AI_BASE_URL=https://openrouter.ai/api/v1
# DUPIN_AI_MODEL_FLASH=openai/gpt-4o-mini
# DUPIN_AI_MODEL_PRO=anthropic/claude-3.5-sonnet
#
# Legacy fallback (optional): DEEPSEEK_API_KEY=...
# Reasoning effort for non-default providers that support it (DeepSeek default: high)
# DUPIN_AI_REASONING_EFFORT=high

# --- Optional data sources ---------------------------------------------------
# Shodan (per-run credit budget is enforced by the engine).
SHODAN_API_KEY=

# Hunter.io keys (optional, round-robin across HUNTER_API_KEY_1..N).
HUNTER_API_KEY_1=
HUNTER_API_KEY_2=

# --- Network -----------------------------------------------------------------
# Direct connections from the host.
# Global requests per second override (default depends on the profile).
# DUPIN_RPS=25
# Disable TLS verification ONLY for lab/self-signed providers. Keep 0 in production.
# DUPIN_INSECURE_TLS=0

# --- Engine ------------------------------------------------------------------
DUPIN_AUTONOMO=1
# DUPIN_ANTILOOP=8
# DUPIN_FORCE_CLOSE=0
# Allow 169.254.169.254 (cloud metadata) as a target. Keep 0.
# DUPIN_ALLOW_METADATA=0
